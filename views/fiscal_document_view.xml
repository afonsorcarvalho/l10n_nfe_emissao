<?xml version="1.0" encoding="utf-8"?>
<!--
    View de documento fiscal com botão de emissão de NF-e.
-->
<odoo>
    <record id="l10n_nfe_emissao_document_form" model="ir.ui.view">
        <field name="name">l10n_nfe_emissao.document.form</field>
        <field name="model">l10n_br_fiscal.document</field>
        <field name="inherit_id" ref="l10n_br_fiscal.document_form" />
        <field name="arch" type="xml">
            <!-- Oculta botão Visualizar XML (XMLs na aba EDI) -->
            <xpath expr="//button[@name='view_xml']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            
            <!-- Ajusta botão "Enviar" padrão para NF-e: visível em 'a_enviar' OU em 'em_digitacao' com chave (reenvio) -->
            <xpath expr="//button[@name='action_document_send'][@string='Enviar']" position="attributes">
                <attribute name="invisible">state_edoc != 'a_enviar' and (state_edoc != 'em_digitacao' or not nfe_key or document_type != '55')</attribute>
            </xpath>

            <!-- Oculta o título "55 - Nota Fiscal Eletrônica" para documentos tipo 55 -->
            <xpath expr="//div[@class='oe_title']/h1" position="attributes">
                <attribute name="invisible">document_type == '55'</attribute>
            </xpath>
            
            <!-- Adiciona motivo da rejeição logo abaixo do título/ribbon -->
            <xpath expr="//sheet/div[@class='oe_title']" position="after">
                <div style="padding: 12px 15px; margin-bottom: 15px; background-color: #fff3cd; border-left: 4px solid #dc3545; color: #721c24;" invisible="state_edoc != 'rejeitada' or document_type != '55'">
                    <div style="margin-bottom: 8px; font-weight: bold; font-size: 14px;">
                        <i class="fa fa-exclamation-triangle" style="color: #dc3545;"/> Motivo da Rejeição:
                    </div>
                    <div style="margin-bottom: 6px;">
                        <strong>Código:</strong> <field name="status_code" readonly="1" nolabel="1" class="oe_inline" style="padding-left: 5px;"/>
                    </div>
                    <div>
                        <strong>Descrição:</strong> <field name="status_name" readonly="1" nolabel="1" class="oe_inline" style="padding-left: 5px;"/>
                    </div>
                </div>
            </xpath>
            
            <!-- Ajusta botão "Confirmar" padrão: para NF-e (55), só visível em 'em_digitacao' sem chave -->
            <xpath expr="//button[@name='action_document_confirm']" position="attributes">
                <attribute name="invisible">state_edoc != 'em_digitacao' or (document_type == '55' and nfe_key)</attribute>
                <attribute name="help">Confirma o documento. Para NF-e: gera a chave de acesso (imutável após confirmação) e altera o estado para 'Aguardando envio'.</attribute>
            </xpath>
            
            <!-- Adiciona botões no header: Consultar -->
            <header position="inside">
                <!-- Botão Consultar NF-e -->
                <button
                    name="action_consultar_nfe"
                    string="Consultar NF-e"
                    type="object"
                    invisible="not nfe_key or document_type != '55'"
                    help="Consulta NF-e na SEFAZ e atualiza procNFe/XML assinado quando ausentes"
                />
            </header>

            <!-- Série: readonly quando há chave (após confirmação) -->
            <field name="document_serie_id" position="attributes">
                <attribute name="readonly">nfe_key</attribute>
            </field>
            
            <!-- Adiciona campo número para edição fácil; readonly quando há chave -->
            <field name="document_serie_id" position="after">
                <field
                    name="document_number"
                    string="Número"
                    help="Número do documento. Pode ser alterado antes da confirmação."
                    readonly="nfe_key"
                />
            </field>

            <!-- Referência mínima à NF-e; demais dados (protocolo, XMLs, DANFE) concentrados na aba EDI -->
            <group name="document_extra" position="after">
                <group
                    string="NF-e"
                    name="nfe_emissao_data"
                    invisible="document_type != '55'"
                    col="2"
                >
                    <field name="nfe_key" invisible="not nfe_key" string="Chave NF-e" help="Chave de acesso (imutável após confirmação). Protocolo, XMLs e DANFE estão na aba EDI." />
                    <field name="return_origin_document_id" invisible="not return_origin_document_id" />
                </group>
            </group>

            <!--
                Attachment preview: exibe o DANFE (PDF) ao lado do formulário,
                como nas faturas do Odoo. Requer div o_attachment_preview e
                anexos (file_report_id) com res_model/res_id do documento.
            -->
            <xpath expr="//chatter" position="before">
                <div class="o_attachment_preview"/>
            </xpath>
        </field>
    </record>
</odoo>
